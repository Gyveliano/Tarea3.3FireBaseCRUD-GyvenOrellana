<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".MainActivity">

    <!-- Logo con título en dos líneas -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Primera línea: CRUD de FireBase -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CRUD de "
                android:textColor="#36C1D6"
                android:textStyle="bold"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FireBase"
                android:textColor="#FF8C00"
                android:textStyle="bold"
                android:textSize="20sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="6dp" />

        <!-- Segunda línea: en Android Studio -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="en Android "
                android:textColor="#36C1D6"
                android:textStyle="bold"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Studio"
                android:textColor="#FF8C00"
                android:textStyle="bold"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Espaciador flexible -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Botones principales (centrados) -->
    <LinearLayout
        android:id="@+id/llButtons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical">

        <Button
            android:id="@+id/btnManagePerson"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gestionar usuarios"
            android:backgroundTint="@color/rimuru_primary"
            android:textColor="@color/text_primary" />

        <View android:layout_width="match_parent" android:layout_height="8dp" />

        <Button
            android:id="@+id/btnShowTable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ver Tabla"
            android:backgroundTint="@color/rimuru_accent"
            android:textColor="@color/text_primary" />

    </LinearLayout>

    <!-- Espaciador flexible -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Botón de salir -->
    <Button
        android:id="@+id/btnExit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Salir"
        android:layout_marginBottom="8dp"
        android:backgroundTint="@color/delete_red"
        android:textColor="@color/white" />

    <!-- Créditos -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingBottom="8dp"
        android:text="Gyven Orellana - 202410010234"
        android:textColor="@color/rimuru_gold"
        android:textSize="12sp"
        android:textStyle="bold" />

</LinearLayout>
